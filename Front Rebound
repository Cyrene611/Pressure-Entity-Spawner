    EnableBlackout = false,
    EnableBreakLights = false,
    
    GithubSound = "",         
    PlayGitSoundWhenSpawned = false, 
    SoundVolume = 2,        
    SoundPlaybackSpeed = 1,

    LightBreakRange = 35,                          
    LightDarkenPercent = 0.11,                
    LightAutoScanInterval = 0.1,              
    
    LightSoundId = "rbxassetid://13303926122", 
    LightSoundVolume = 2,                   
    LightSoundDistance = 150,                 
    
    LightParticleTexture = "rbxassetid://257173628", 
    LightParticleDuration = 0.3,
    
    DeathImage = "rbxassetid://11417375410",
    DeathName = "R-3303",
    DeathNotes = "Ummmm",
    DeathImageColor = Color3.fromRGB(255, 255, 255),
    
    OnSpawn = function(self)
        -- HỆ THỐNG ĐIỀU CHỈNH TỐC ĐỘ DỰA TRÊN KHOẢNG CÁCH VÀ SÁT THƯƠNG
        task.spawn(function()
            local originalSpeed = 200
            local nearDistance = 100
            local nearSpeed = 60
            local damageSpeed = 10

            local player = game:GetService("Players").LocalPlayer
            local RunService = game:GetService("RunService")
            local lastCFrame = nil
            local speedConn

            speedConn = RunService.Heartbeat:Connect(function()
                local entityModel = (self and self.Model) or workspace:FindFirstChild("ReboundChild")
                if not entityModel or not entityModel.Parent then
                    if speedConn then speedConn:Disconnect() end
                    return
                end

                local root = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart")
                local char = player.Character
                local pRoot = char and char:FindFirstChild("HumanoidRootPart")

                if root and pRoot then
                    local currentCFrame = root.CFrame

                    if lastCFrame then
                        local distToPlayer = (root.Position - pRoot.Position).Magnitude
                        local targetSpeed = originalSpeed

                        -- Ưu tiên 1: Đang trong thời gian gây sát thương -> Giảm tốc về 10
                        if (os.clock() - lastDamageTick) < 0.25 then
                            targetSpeed = damageSpeed
                        -- Ưu tiên 2: Đến gần người chơi dưới 90 studs -> Giảm tốc về 55
                        elseif distToPlayer <= nearDistance then
                            targetSpeed = nearSpeed
                        end

                        local speedRatio = targetSpeed / originalSpeed

                        -- Xử lý Ghìm tốc độ di chuyển CFrame
                        if speedRatio < 1 then
                            local deltaVec = currentCFrame.Position - lastCFrame.Position
                            if deltaVec.Magnitude > 0.001 then
                                local newPos = lastCFrame.Position + (deltaVec * speedRatio)
                                local newCFrame = CFrame.new(newPos) * currentCFrame.Rotation
                                entityModel:PivotTo(newCFrame)
                                currentCFrame = newCFrame
                            end
                        end
                    end

                    lastCFrame = currentCFrame
                end
            end)
        end)
    end,
    OnMoveStart = function() end,
    OnRoomEnter = function(roomName) end,
    OnDamagePlayer = function()
        -- Cập nhật thời điểm vừa gây sát thương để kích hoạt tốc độ 10
        lastDamageTick = os.clock()
    end,
    OnKillPlayer = function() end,
    OnDespawning = function() end,
    OnDespawned = function() end,
})
