local function loadEntityModel()
    local success, objects = pcall(game.GetObjects, game, EntityConfig.AssetId)
    if not success or #objects == 0 then error("Không load được asset: " .. tostring(objects)) end
    
    local model = objects[1]
    if not model then error("[EntitySystem] Asset không phải Model!") end

    model.Name = EntityConfig.EntityName
    model.Parent = workspace
    if not model.PrimaryPart then
        local firstPart = model:FindFirstChildWhichIsA("BasePart", true)
        if not firstPart then error("[EntitySystem] Model không có BasePart!") end
        model.PrimaryPart = firstPart
    end
    return model
end

